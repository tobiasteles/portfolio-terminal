# Connection string do Neon (painel do Neon > Connect). Mantenha ?sslmode=require
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Segredo usado para assinar o JWT da sessão. Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Credenciais do primeiro admin (usadas apenas pelo script `npm run db:seed`)
ADMIN_EMAIL="voce@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"

# --- Avisos de novas mensagens (todos opcionais) ---

# E-mail via Resend (https://resend.com). Crie uma API key e informe para onde enviar.
# Sem domínio verificado, o Resend só entrega para o e-mail da sua própria conta.
RESEND_API_KEY=""
NOTIFY_EMAIL_TO="voce@exemplo.com"
# NOTIFY_EMAIL_FROM="Portfólio <contato@seudominio.com>"   # só após verificar um domínio

# WhatsApp via CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/).
# Telefone com DDI, sem + (ex.: 5561999999999). A apikey chega no WhatsApp após a ativação.
CALLMEBOT_PHONE=""
CALLMEBOT_APIKEY=""
